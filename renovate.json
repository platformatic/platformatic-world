{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "rangeStrategy": "update-lockfile",
  "ignoreDeps": [
    "camelcase",
    "mysql",
    "swagger-ui-react",
    "leven",
    "ora",
    "graphiql",
    "actions/checkout"
  ],
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "e2e-v4 exercises the v4 SDK deliberately. v5 is now npm 'latest' and v4 lives on the 'previous' tag, so hold this app on the v4 line; without this renovate proposes a major bump that breaks the compat suite.",
      "matchFileNames": [
        "e2e-v4/package.json"
      ],
      "matchPackageNames": [
        "workflow",
        "@workflow/world"
      ],
      "allowedVersions": "<5.0.0"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "timezone": "Europe/Rome",
  "schedule": [
    "* 0-6 * * 6,0"
  ],
  "rebaseWhen": "conflicted"
}
